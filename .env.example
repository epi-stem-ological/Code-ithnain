# ---------------------------------------------------------------------------
# Template. Copy to .env and fill in:   cp .env.example .env
# .env is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# Required. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional. Model to use (default: gemini-2.5-flash).
# gemini-2.5-pro is slower and pricier but stronger on long videos.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Output directory used by the youtube_agent package CLI.
YTA_OUTPUT_DIR=out
